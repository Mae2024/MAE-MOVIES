@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> SignInManager


<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - mae_movie</title>
    <script type="importmap"></script>

    <!-- Bootstrap primero -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @*     <link rel="stylesheet" href="~/mae_movie.styles.css" asp-append-version="true" />
 *@
    <!-- Fuentes -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />

    <!-- Tailwind después, con preflight apagado para no pisar Bootstrap -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">

        tailwind.config = {
        darkMode: "class",
        corePlugins: {
        preflight: false,
        visibility: false
        },
        theme: {
        extend: {
        colors: {
        "error-container": "#93000a",
        "surface-container-lowest": "#0e0e0e",
        "tertiary": "#ffb599",
        "tertiary-fixed": "#ffdbce",
        "on-surface": "#e5e2e1",
        "primary-fixed-dim": "#b1c5ff",
        "secondary-fixed": "#ffdf9e",
        "inverse-surface": "#e5e2e1",
        "on-tertiary-fixed": "#370e00",
        "surface-container": "#201f1f",
        "primary-container": "#0d6efd",
        "outline-variant": "#424655",
        "inverse-primary": "#0057ce",
        "tertiary-fixed-dim": "#ffb599",
        "on-tertiary-fixed-variant": "#7f2b00",
        "on-error-container": "#ffdad6",
        "surface-container-highest": "#353534",
        "on-primary-fixed-variant": "#00419e",
        "on-primary": "#002c70",
        "primary-fixed": "#dae2ff",
        "secondary": "#ffdf9e",
        "on-secondary-container": "#6a4e00",
        "inverse-on-surface": "#313030",
        "secondary-container": "#fabd00",
        "secondary-fixed-dim": "#fabd00",
        "on-tertiary": "#5a1c00",
        "on-secondary-fixed": "#261a00",
        "surface-container-low": "#1c1b1b",
        "on-background": "#e5e2e1",
        "on-error": "#690005",
        "outline": "#8c90a1",
        "background": "#131313",
        "tertiary-container": "#cf4b00",
        "surface-variant": "#353534",
        "on-primary-fixed": "#001946",
        "surface-tint": "#b1c5ff",
        "on-secondary-fixed-variant": "#5b4300",
        "surface-dim": "#131313",
        "on-primary-container": "#ffffff",
        "on-surface-variant": "#c2c6d8",
        "primary": "#b1c5ff",
        "surface-bright": "#393939",
        "surface-container-high": "#2a2a2a",
        "error": "#ffb4ab",
        "on-secondary": "#3f2e00",
        "surface": "#131313",
        "on-tertiary-container": "#ffffff"
        },
        borderRadius: {
        DEFAULT: "0.25rem",
        lg: "0.5rem",
        xl: "0.75rem",
        full: "9999px"
        },
        spacing: {
        gutter: "1.5rem",
        base: "8px",
        "container-max": "1320px",
        "section-padding": "4rem"
        },
        fontFamily: {
        "headline-lg-mobile": ["Inter"],
        "label-md": ["Inter"],
        "body-lg": ["Inter"],
        "body-md": ["Inter"],
        "headline-md": ["Inter"],
        "headline-lg": ["Inter"],
        "display-lg": ["Inter"]
        },
        fontSize: {
        "headline-lg-mobile": ["28px", { lineHeight: "1.2", fontWeight: "700" }],
        "label-md": ["14px", { lineHeight: "1", letterSpacing: "0.05em", fontWeight: "600" }],
        "body-lg": ["18px", { lineHeight: "1.6", fontWeight: "400" }],
        "body-md": ["16px", { lineHeight: "1.5", fontWeight: "400" }],
        "headline-md": ["24px", { lineHeight: "1.3", fontWeight: "600" }],
        "headline-lg": ["32px", { lineHeight: "1.2", fontWeight: "700" }],
        "display-lg": ["48px", { lineHeight: "1.1", letterSpacing: "-0.02em", fontWeight: "800" }]
        }
        }
        }
        }
    </script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col font-body-md text-body-md">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-surface-container shadow-[0_10px_30px_rgba(0,0,0,0.5)] border-b border-white/5 mb-3">
            <div class="container-fluid px-gutter">
                <a class="navbar-brand text-on-surface font-bold flex items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="material-symbols-outlined text-primary">movie</span>
                    CineManager
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-on-surface-variant hover:text-primary transition-colors" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-on-surface-variant hover:text-primary transition-colors" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-on-surface-variant hover:text-primary transition-colors" asp-area="" asp-controller="Genero" asp-action="Index">Géneros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-on-surface-variant hover:text-primary transition-colors" asp-area="" asp-controller="Plataformas" asp-action="Index">Plataformas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-on-surface-variant hover:text-primary transition-colors" asp-area="" asp-controller="Pelicula" asp-action="Index">Peliculas</a>
                        </li>
                    </ul>
                </div>
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-on-surface-variant">Hola, @User.Identity.Name!</span>
                        <form method="post" asp-area="" asp-controller="Usuario" asp-action="Logout" class="m-0">
                            @Html.AntiForgeryToken()
                            <a class="nav-link text-on-surface-variant hover:text-primary transition-colors" asp-area="" asp-controller="Usuario" asp-action="MiPerfil">Mi Perfil</a>
                            <button type="submit" class="btn btn-link text-on-surface-variant hover:text-primary transition-colors p-0">Cerrar sesión</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-link text-on-surface-variant hover:text-primary transition-colors p-0" asp-area="" asp-controller="Usuario" asp-action="Registro">Iniciar sesión</a>
                        <a class="btn btn-link text-on-surface-variant hover:text-primary transition-colors p-0" asp-area="" asp-controller="Usuario" asp-action="Registro">Registrarse</a>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="flex-grow w-full max-w-[1320px] mx-auto px-4 md:px-gutter">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t border-white/5 text-on-surface-variant py-4 mt-auto">
        <div class="container-fluid px-gutter">
            &copy; 2026 - mae_movie - <a class="text-primary" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>