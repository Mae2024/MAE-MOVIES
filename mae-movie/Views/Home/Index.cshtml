@model List<Pelicula>
@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <style>
        .card-elevated {
            background-color: #1e1e1e;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .card-elevated:hover {
                transform: scale(1.03);
                box-shadow: 0 15px 35px rgba(0,0,0,0.6);
            }

        .movie-aspect {
            aspect-ratio: 2/3;
            object-fit: cover;
        }

        .star-filled {
            color: #fabd00;
            font-variation-settings: 'FILL' 1;
        }

        .star-empty {
            color: #fabd00;
            font-variation-settings: 'FILL' 0;
        }

        .filter-scroll::-webkit-scrollbar {
            height: 4px;
        }

        .filter-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .filter-scroll::-webkit-scrollbar-thumb {
            background: #424655;
            border-radius: 4px;
        }
    </style>
}

<div class="mb-2">
    <div class="relative max-w-xs">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none">search</span>
        <input id="searchInput"
               type="text"
               placeholder="Buscar película..."
               class="bg-surface-container-high border border-white/10 rounded-full pl-10 pr-4 py-2 text-body-md font-body-md text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:border-primary transition-colors w-full" />
    </div>
</div>

<!-- Filters Section -->
<section class="mb-8 bg-surface-container-high rounded-xl p-4 shadow-[0_5px_15px_rgba(0,0,0,0.3)] border border-white/5">
    <div class="flex flex-col md:flex-row gap-6">
        @{
            var selectedGenero = ViewBag.SelectedGeneroId as int?;
            var selectedPlataforma = ViewBag.SelectedPlataformaId as int?;
            var generos = ViewBag.Generos as List<mae_movie.Models.Genero> ?? new List<mae_movie.Models.Genero>();
            var plataformas = ViewBag.Plataformas as List<mae_movie.Models.Plataforma> ?? new List<mae_movie.Models.Plataforma>();
        }
        <div class="flex-1">
            <h3 class="text-label-md font-label-md text-on-surface-variant mb-3 uppercase tracking-wider">Generos</h3>
            <div class="flex flex-wrap gap-1.5">
                <a asp-action="Index" asp-route-page="1" class="px-2.5 py-1 rounded-full @(selectedGenero == null ? "bg-primary-container text-on-primary-container" : "bg-white/10 text-on-surface")">Todos</a>
                @foreach (var g in generos)
                {
                    <a asp-action="Index" asp-route-page="1" asp-route-generoId="@g.Id" asp-route-plataformaId="@(selectedPlataforma)" class="px-4 py-1.5 rounded-full @(selectedGenero == g.Id ? "bg-primary-container text-on-primary-container" : "bg-white/10 text-on-surface")">@g.Descripcion</a>
                }
            </div>
        </div>
        <div class="flex-1">
            <h3 class="text-label-md font-label-md text-on-surface-variant mb-3 uppercase tracking-wider">Plataformas</h3>
            <div class="flex flex-wrap gap-1.5">
                <a asp-action="Index" asp-route-page="1" class="px-2.5 py-1 rounded-full @(selectedPlataforma == null ? "bg-primary-container text-on-primary-container" : "bg-white/10 text-on-surface")">Todas</a>
                @foreach (var p in plataformas)
                {
                    <a asp-action="Index" asp-route-page="1" asp-route-plataformaId="@p.Id" asp-route-generoId="@(selectedGenero)" class="px-2.5 py-1 rounded-full @(selectedPlataforma == p.Id ? "bg-primary-container text-on-primary-container" : "bg-white/10 text-on-surface")">@p.Nombre</a>
                }
            </div>
        </div>
    </div>
</section>

<!-- Movie Grid -->
<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
    @foreach (var pelicula in Model)
    {
        <a asp-action="Details" asp-route-id="@pelicula.Id">
        <div class="card-elevated rounded-lg overflow-hidden flex flex-col group cursor-pointer border border-white/5 relative">
            @if (!string.IsNullOrEmpty(pelicula.PosterUrl))
            {
                <img class="w-full movie-aspect" src="@pelicula.PosterUrl" alt="@pelicula.Titulo" />
            }
            else
            {
                <div class="w-full movie-aspect bg-white/5 flex items-center justify-center text-on-surface-variant">No imagen</div>
            }
            <div class="p-3 flex flex-col gap-2 flex-grow">
                <h4 class="font-label-md text-label-md text-on-surface truncate">@pelicula.Titulo</h4>
            </div>
        </div>
        </a>
    }
</div>

@{
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}
<div class="flex justify-center items-center mt-6 gap-2">
    @if (currentPage > 1)
    {
        <a asp-action="Index" asp-route-page="@(currentPage - 1)" class="px-3 py-1 rounded bg-white/10 hover:bg-white/20 text-on-surface-variant">Anterior</a>
    }
    else
    {
        <span class="px-3 py-1 rounded bg-white/5 text-on-surface-variant opacity-40 pointer-events-none" aria-disabled="true">Anterior</span>
    }
    @for (int i = 1; i <= totalPages; i++)
    {
        <a asp-action="Index" asp-route-page="@i" class="px-2 py-1 rounded @(i == currentPage ? "bg-primary text-on-primary-container" : "bg-white/5 text-on-surface-variant")">@i</a>
    }
    @if (currentPage < totalPages)
    {
        <a asp-action="Index" asp-route-page="@(currentPage + 1)" class="px-3 py-1 rounded bg-white/10 hover:bg-white/20 text-on-surface-variant">Siguiente</a>
    }
    else
    {
        <span class="px-3 py-1 rounded bg-white/5 text-on-surface-variant opacity-40 pointer-events-none" aria-disabled="true">Siguiente</span>
    }
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const cards = document.querySelectorAll('.card-elevated');

        searchInput.addEventListener('input', (e) => {
            const term = e.target.value.trim().toLowerCase();
            cards.forEach(card => {
                const title = card.querySelector('h4')?.textContent.toLowerCase() || '';
                card.style.display = title.includes(term) ? '' : 'none';
            });
        });
    </script>
}