@model List<Pelicula>
@{
    ViewData["Title"] = "Home Page";
}
<!DOCTYPE html>

<html class="dark" lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>CineManager - Home</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "error-container": "#93000a",
        "surface-container-lowest": "#0e0e0e",
        "tertiary": "#ffb599",
        "tertiary-fixed": "#ffdbce",
        "on-surface": "#e5e2e1",
        "primary-fixed-dim": "#b1c5ff",
        "secondary-fixed": "#ffdf9e",
        "inverse-surface": "#e5e2e1",
        "on-tertiary-fixed": "#370e00",
        "surface-container": "#201f1f",
        "primary-container": "#0d6efd",
        "outline-variant": "#424655",
        "inverse-primary": "#0057ce",
        "tertiary-fixed-dim": "#ffb599",
        "on-tertiary-fixed-variant": "#7f2b00",
        "on-error-container": "#ffdad6",
        "surface-container-highest": "#353534",
        "on-primary-fixed-variant": "#00419e",
        "on-primary": "#002c70",
        "primary-fixed": "#dae2ff",
        "secondary": "#ffdf9e",
        "on-secondary-container": "#6a4e00",
        "inverse-on-surface": "#313030",
        "secondary-container": "#fabd00",
        "secondary-fixed-dim": "#fabd00",
        "on-tertiary": "#5a1c00",
        "on-secondary-fixed": "#261a00",
        "surface-container-low": "#1c1b1b",
        "on-background": "#e5e2e1",
        "on-error": "#690005",
        "outline": "#8c90a1",
        "background": "#131313",
        "tertiary-container": "#cf4b00",
        "surface-variant": "#353534",
        "on-primary-fixed": "#001946",
        "surface-tint": "#b1c5ff",
        "on-secondary-fixed-variant": "#5b4300",
        "surface-dim": "#131313",
        "on-primary-container": "#ffffff",
        "on-surface-variant": "#c2c6d8",
        "primary": "#b1c5ff",
        "surface-bright": "#393939",
        "surface-container-high": "#2a2a2a",
        "error": "#ffb4ab",
        "on-secondary": "#3f2e00",
        "surface": "#131313",
        "on-tertiary-container": "#ffffff"
        },
        "borderRadius": {
        "DEFAULT": "0.25rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "full": "9999px"
        },
        "spacing": {
        "gutter": "1.5rem",
        "base": "8px",
        "container-max": "1320px",
        "section-padding": "4rem"
        },
        "fontFamily": {
        "headline-lg-mobile": ["Inter"],
        "label-md": ["Inter"],
        "body-lg": ["Inter"],
        "body-md": ["Inter"],
        "headline-md": ["Inter"],
        "headline-lg": ["Inter"],
        "display-lg": ["Inter"]
        },
        "fontSize": {
        "headline-lg-mobile": ["28px", { "lineHeight": "1.2", "fontWeight": "700" }],
        "label-md": ["14px", { "lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "600" }],
        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
        "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }],
        "headline-md": ["24px", { "lineHeight": "1.3", "fontWeight": "600" }],
        "headline-lg": ["32px", { "lineHeight": "1.2", "fontWeight": "700" }],
        "display-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "800" }]
        }
        }
        }
        }
    </script>

    <style>
        body {
        background-color: #121212;
        color: #e5e2e1;
        }

        .card-elevated {
        background-color: #1e1e1e;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card-elevated:hover {
        transform: scale(1.03);
        box-shadow: 0 15px 35px rgba(0,0,0,0.6);
        }

        .movie-aspect {
        aspect-ratio: 2/3;
        object-fit: cover;
        }

        .star-filled {
        color: #fabd00;
        font-variation-settings: 'FILL' 1;
        }

        .star-empty {
        color: #fabd00;
        font-variation-settings: 'FILL' 0;
        }

        /* Custom Scrollbar for Filters */
        .filter-scroll::-webkit-scrollbar {
        height: 4px;
        }

        .filter-scroll::-webkit-scrollbar-track {
        background: transparent;
        }

        .filter-scroll::-webkit-scrollbar-thumb {
        background: #424655;
        border-radius: 4px;
        }
    </style>

</head>


<body class="bg-background text-on-background min-h-screen flex flex-col font-body-md text-body-md">
    <!-- TopAppBar -->
    <header class="bg-surface-container shadow-[0_10px_30px_rgba(0,0,0,0.5)] border-b border-white/5 flex justify-between items-center w-full px-gutter h-16 sticky top-0 z-40">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-headline-md">movie</span>
            <span class="text-headline-md font-headline-md font-bold text-on-surface">CineManager</span>
        </div>
        <!-- Desktop Nav -->
        <nav class="hidden md:flex gap-6 items-center">
            <a class="text-primary font-bold hover:text-primary transition-colors text-label-md font-label-md" href="#">Home</a>
            <a class="text-on-surface-variant hover:text-primary transition-colors text-label-md font-label-md" href="#">Favorites</a>
            <a class="text-on-surface-variant hover:text-primary transition-colors text-label-md font-label-md" href="#">Profile</a>
            <a class="text-on-surface-variant hover:text-primary transition-colors text-label-md font-label-md" href="#">Admin</a>
        </nav>
        <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none">search</span>
            <input id="searchInput"
                   type="text"
                   placeholder="Buscar película..."
                   class="bg-surface-container-high border border-white/10 rounded-full pl-10 pr-4 py-2 text-body-md font-body-md text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:border-primary transition-colors w-40 md:w-64" />
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow pb-24 md:pb-12 pt-8 w-full max-w-[1320px] mx-auto px-4 md:px-gutter">
        <!-- Filters Section -->
        <section class="mb-8 bg-surface-container-high rounded-xl p-4 shadow-[0_5px_15px_rgba(0,0,0,0.3)] border border-white/5">
            <div class="flex flex-col md:flex-row gap-6">
                <!-- Genre Filter -->
                <div class="flex-1">
                    <h3 class="text-label-md font-label-md text-on-surface-variant mb-3 uppercase tracking-wider">Generos</h3>
                    <div class="flex gap-2 overflow-x-auto filter-scroll pb-2">
                        <button class="px-4 py-1.5 rounded-full bg-primary-container text-on-primary-container text-label-md font-label-md whitespace-nowrap active:scale-95 transition-transform">Todos</button>
                        <button class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-on-surface text-label-md font-label-md whitespace-nowrap transition-colors active:scale-95 transition-transform border border-transparent hover:border-outline-variant">Acción</button>
                        <button class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-on-surface text-label-md font-label-md whitespace-nowrap transition-colors active:scale-95 transition-transform border border-transparent hover:border-outline-variant">Drama</button>
                        <button class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-on-surface text-label-md font-label-md whitespace-nowrap transition-colors active:scale-95 transition-transform border border-transparent hover:border-outline-variant">Sci-Fi</button>
                        <button class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-on-surface text-label-md font-label-md whitespace-nowrap transition-colors active:scale-95 transition-transform border border-transparent hover:border-outline-variant">Comedia</button>
                        <button class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-on-surface text-label-md font-label-md whitespace-nowrap transition-colors active:scale-95 transition-transform border border-transparent hover:border-outline-variant">Terror</button>
                    </div>
                </div>
                <!-- Platform Filter -->
                <div class="flex-1">
                    <h3 class="text-label-md font-label-md text-on-surface-variant mb-3 uppercase tracking-wider">Plataformas</h3>
                    <div class="flex gap-2 overflow-x-auto filter-scroll pb-2">
                        <button class="px-4 py-1.5 rounded-full bg-primary-container text-on-primary-container text-label-md font-label-md whitespace-nowrap active:scale-95 transition-transform">Todas</button>
                        <button class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-on-surface text-label-md font-label-md whitespace-nowrap transition-colors active:scale-95 transition-transform border border-transparent hover:border-outline-variant">Netflix</button>
                        <button class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-on-surface text-label-md font-label-md whitespace-nowrap transition-colors active:scale-95 transition-transform border border-transparent hover:border-outline-variant">HBO Max</button>
                        <button class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-on-surface text-label-md font-label-md whitespace-nowrap transition-colors active:scale-95 transition-transform border border-transparent hover:border-outline-variant">Disney+</button>
                        <button class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-on-surface text-label-md font-label-md whitespace-nowrap transition-colors active:scale-95 transition-transform border border-transparent hover:border-outline-variant">Prime Video</button>
                    </div>
                </div>
            </div>
        </section>
        <!-- Movie Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
            <!-- Movie Card 1 -->
            @foreach (var pelicula in Model)
            {
                <div class="card-elevated rounded-lg overflow-hidden flex flex-col group cursor-pointer border border-white/5 relative">
                    @if (!string.IsNullOrEmpty(pelicula.PosterUrl))
                    {
                        <img class="w-full movie-aspect" src="@pelicula.PosterUrl" alt="@pelicula.Titulo" />
                    }
                    else
                    {
                        <div class="w-full movie-aspect bg-white/5 flex items-center justify-center text-on-surface-variant">No imagen</div>
                    }
                    <div class="p-3 flex flex-col gap-2 flex-grow">
                        <h4 class="font-label-md text-label-md text-on-surface truncate">@pelicula.Titulo</h4>
                    </div>
                </div>
            }
            <!-- Movie Card 2 -->

        </div>

        @{
            var currentPage = ViewBag.CurrentPage as int? ?? 1;
            var totalPages = ViewBag.TotalPages as int? ?? 1;
        }
        <div class="flex justify-center items-center mt-6 gap-2">
            @if (currentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(currentPage-1)" class="px-3 py-1 rounded bg-white/10 hover:bg-white/20 text-on-surface-variant">Anterior</a>
            }
            else
            {
                <span class="px-3 py-1 rounded bg-white/5 text-on-surface-variant opacity-40 pointer-events-none" aria-disabled="true">Anterior</span>
            }
            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-action="Index" asp-route-page="@i" class="px-2 py-1 rounded @(i == currentPage ? "bg-primary text-on-primary-container" : "bg-white/5 text-on-surface-variant")">@i</a>
            }
            @if (currentPage < totalPages)
            {
                <a asp-action="Index" asp-route-page="@(currentPage+1)" class="px-3 py-1 rounded bg-white/10 hover:bg-white/20 text-on-surface-variant">Siguiente</a>
            }
            else
            {
                <span class="px-3 py-1 rounded bg-white/5 text-on-surface-variant opacity-40 pointer-events-none" aria-disabled="true">Siguiente</span>
            }
        </div>

</main>
<script>
    const searchInput = document.getElementById('searchInput');
    const cards = document.querySelectorAll('.card-elevated');

    searchInput.addEventListener('input', (e) => {
    const term = e.target.value.trim().toLowerCase();
    cards.forEach(card => {
    const title = card.querySelector('h4')?.textContent.toLowerCase() || '';
    card.style.display = title.includes(term) ? '' : 'none';
    });
    });
</script>
</body>


</html>